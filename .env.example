# Copy this file to .env and fill in the values. .env is gitignored.
# In production these come from GitHub Actions secrets instead — see
# .github/workflows/main.yml.

# Last.fm now-playing widget on the home hero.
# Key: https://www.last.fm/api/accounts  ·  Username: your Last.fm handle.
# VITE_ prefixed, so these are bundled into the client. The Last.fm key is
# read-only and safe to expose; do not add other secrets with this prefix.
VITE_LASTFM_USERNAME=
VITE_LASTFM_API_KEY=

# Activity routes, pulled at build time by scripts/fetch-activities.mjs.
# Key: intervals.icu -> Settings -> Developer Settings.
# No VITE_ prefix: read only by the build script, never sent to the browser.
INTERVALS_API_KEY=
# Optional. "0" (the default) means whoever owns the key.
INTERVALS_ATHLETE_ID=
